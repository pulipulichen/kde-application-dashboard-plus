        "Description[zh_CN]": "支持中文输入与单一菜单开启的全屏启动器",
        "Description[ja]": "中国語入力と単一表示に対応した全画面ランチャー",
        "Icon": "start-here-kde",
        "Version": "0.1.1",
        "License": "GPL-3.0-or-later",
        "Category": "Application Launchers",
        "ServiceTypes": [
            "Plasma/Applet"
        ],
        "EnabledByDefault": true,
        "Authors": [
            {
                "Name": "Yung-Ting Chen"
            },
            {
                "Name": "Eike Hein",
                "Email": "hein@kde.org"
            }
        ],
        "Website": "https://github.com/pulipulichen/kde-application-dashboard-plus",
        "BugReportUrl": "https://github.com/pulipulichen/kde-application-dashboard-plus/issues"
    },
    "X-Plasma-API": "declarativeappletscript",
    "X-Plasma-MainScript": "ui/main.qml",
    "X-Plasma-Provides": [
        "org.kde.plasma.launchermenu"
    ],
    "X-Plasma-API-Minimum-Version": "5.27"
