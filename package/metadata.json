{
    "KPlugin": {
        "Id": "com.pulipuli.applicationdashboardplus",
        "Name": "Application Dashboard Plus",
        "Name[zh_TW]": "應用程式儀表板 Plus",
        "Name[zh_CN]": "应用程序仪表板 Plus",
        "Name[ja]": "アプリケーションダッシュボード Plus",
